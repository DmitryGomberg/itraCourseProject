@inject IViewLocalizer Localizer
@model CvManagement.Web.Models.Positions.PositionIndexViewModel
@{
    ViewData["Title"] = Localizer["Positions"];
}

<h2>@Localizer["Positions"]</h2>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" asp-action="Index" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["Search by title..."]" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary btn-sm">@Localizer["Filter"]</button>
        </div>
    </div>
</form>

<div class="toolbar mb-3">
    <a asp-action="Create" class="btn btn-primary btn-sm">+ @Localizer["+ Create"]</a>
    <a class="btn btn-warning btn-sm d-none" id="btnEdit">@Localizer["Edit"]</a>
    <form method="post" asp-action="Delete" class="d-inline" id="deleteForm">
        <button type="submit" class="btn btn-danger btn-sm d-none" id="btnDelete">@Localizer["Delete"]</button>
    </form>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th style="width:40px"></th>
            <th>@Localizer["Title"]</th>
            <th>@Localizer["Public"]</th>
            <th>@Localizer["Max Projects"]</th>
            <th>@Localizer["Attributes"]</th>
            <th>@Localizer["Access Rules"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td><input type="checkbox" class="form-check-input row-checkbox" data-id="@item.Id" /></td>
                <td><a asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td>
                <td>@(item.IsPublic ? Localizer["Yes"] : Localizer["No"])</td>
                <td>@item.MaxProjects</td>
                <td>@item.AttributesCount</td>
                <td>@item.AccessRulesCount</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        (function () {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            const btnEdit = document.getElementById('btnEdit');
            const btnDelete = document.getElementById('btnDelete');
            const deleteForm = document.getElementById('deleteForm');

            function updateToolbar() {
                const checked = document.querySelectorAll('.row-checkbox:checked');
                const count = checked.length;
                btnEdit.classList.toggle('d-none', count !== 1);
                btnDelete.classList.toggle('d-none', count < 1);
                if (count === 1) {
                    btnEdit.href = '@Url.Action("Edit")/' + checked[0].dataset.id;
                }
            }

            checkboxes.forEach(cb => cb.addEventListener('change', updateToolbar));

            deleteForm.addEventListener('submit', function (e) {
                if (!confirm('Удалить выбранные позиции?')) {
                    e.preventDefault();
                    return;
                }
                deleteForm.querySelectorAll('input[name="ids"]').forEach(el => el.remove());
                document.querySelectorAll('.row-checkbox:checked').forEach(cb => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'ids';
                    input.value = cb.dataset.id;
                    deleteForm.appendChild(input);
                });
            });
        })();
    </script>
}
