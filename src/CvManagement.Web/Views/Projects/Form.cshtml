@inject IViewLocalizer Localizer
@model CvManagement.Web.Models.Projects.ProjectFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? Localizer["Edit Project"] : Localizer["Create Project"];
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (isEdit)
            {
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Version" />
            }

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PeriodStart" class="form-label">@Localizer["Start Date"]</label>
                <input asp-for="PeriodStart" type="date" class="form-control" />
                <span asp-validation-for="PeriodStart" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="IsOngoing" class="form-check-input" id="isOngoingCheck" />
                    <label asp-for="IsOngoing" class="form-check-label">@Localizer["Ongoing (current project)"]</label>
                </div>
            </div>

            <div class="mb-3" id="periodEndContainer">
                <label asp-for="PeriodEnd" class="form-label">@Localizer["End Date"]</label>
                <input asp-for="PeriodEnd" type="date" class="form-control" id="periodEndInput" />
                <span asp-validation-for="PeriodEnd" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DescriptionMarkdown" class="form-label">@Localizer["Description (Markdown supported)"]</label>
                <textarea asp-for="DescriptionMarkdown" class="form-control" rows="6"></textarea>
                <span asp-validation-for="DescriptionMarkdown" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TagsInput" class="form-label">@Localizer["Tags (comma-separated)"]</label>
                <input asp-for="TagsInput" class="form-control" list="tagSuggestions" placeholder="e.g. C#, ASP.NET, React" autocomplete="off" />
                <datalist id="tagSuggestions"></datalist>
            </div>

            <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            <a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const isOngoing = document.getElementById('isOngoingCheck');
            const periodEndContainer = document.getElementById('periodEndContainer');
            const periodEndInput = document.getElementById('periodEndInput');
            const tagInput = document.querySelector('[data-val="TagsInput"]') || document.getElementById('TagsInput');
            const datalist = document.getElementById('tagSuggestions');
            let debounceTimer = null;

            function togglePeriodEnd() {
                if (isOngoing.checked) {
                    periodEndInput.disabled = true;
                    periodEndInput.value = '';
                } else {
                    periodEndInput.disabled = false;
                }
            }

            isOngoing.addEventListener('change', togglePeriodEnd);
            togglePeriodEnd();

            if (tagInput) {
                tagInput.addEventListener('input', function () {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(function () {
                        const val = tagInput.value.trim();
                        if (val.length < 1) { datalist.innerHTML = ''; return; }

                        fetch('/api/tags/search?q=' + encodeURIComponent(val))
                            .then(function (r) { return r.json(); })
                            .then(function (items) {
                                datalist.innerHTML = '';
                                items.forEach(function (t) {
                                    const opt = document.createElement('option');
                                    opt.value = t.name;
                                    datalist.appendChild(opt);
                                });
                            });
                    }, 300);
                });
            }
        })();
    </script>
}
