@inject IViewLocalizer Localizer
@model IEnumerable<CvManagement.Web.Models.Projects.ProjectListItemViewModel>
@{
    ViewData["Title"] = Localizer["My Projects"];
}

<h2>@Localizer["My Projects"]</h2>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="toolbar mb-3">
    <a asp-action="Create" class="btn btn-primary btn-sm">+ @Localizer["+ Create"]</a>
    <a class="btn btn-warning btn-sm d-none" id="btnEdit">@Localizer["Edit"]</a>
    <form method="post" asp-action="Delete" class="d-inline" id="deleteForm">
        <button type="submit" class="btn btn-danger btn-sm d-none" id="btnDelete">@Localizer["Delete"]</button>
    </form>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th style="width:40px"></th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Period"]</th>
            <th>@Localizer["Tags"]</th>
            <th>@Localizer["Description"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><input type="checkbox" class="form-check-input row-checkbox" data-id="@item.Id" /></td>
                <td>@item.Name</td>
                <td>@item.PeriodDisplay</td>
                <td>@item.TagsDisplay</td>
                <td>@item.DescriptionShort</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        (function () {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            const btnEdit = document.getElementById('btnEdit');
            const btnDelete = document.getElementById('btnDelete');
            const deleteForm = document.getElementById('deleteForm');

            function updateToolbar() {
                const checked = document.querySelectorAll('.row-checkbox:checked');
                const count = checked.length;
                btnEdit.classList.toggle('d-none', count !== 1);
                btnDelete.classList.toggle('d-none', count < 1);
                if (count === 1) {
                    btnEdit.href = '@Url.Action("Edit")/' + checked[0].dataset.id;
                }
            }

            checkboxes.forEach(cb => cb.addEventListener('change', updateToolbar));

            deleteForm.addEventListener('submit', function (e) {
                if (!confirm('Удалить выбранные проекты?')) {
                    e.preventDefault();
                    return;
                }
                deleteForm.querySelectorAll('input[name="ids"]').forEach(el => el.remove());
                document.querySelectorAll('.row-checkbox:checked').forEach(cb => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'ids';
                    input.value = cb.dataset.id;
                    deleteForm.appendChild(input);
                });
            });
        })();
    </script>
}
