@model CvManagement.Web.Models.Home.HomeIndexViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["CV Management System"];
}

<h1 class="mb-4">@Localizer["CV Management System"]</h1>

@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Candidate"))
{
    <a asp-controller="BrowsePositions" asp-action="Index" class="btn btn-primary mb-4">@Localizer["Browse available positions"]</a>
}

<div class="row mb-4 g-3">
    <div class="col-md-4">
        <div class="card stat-card stat-primary">
            <div class="card-body text-center">
                <div class="stat-number">@Model.TotalCandidates</div>
                <div class="stat-label">@Localizer["Candidates"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card stat-success">
            <div class="card-body text-center">
                <div class="stat-number">@Model.TotalPositions</div>
                <div class="stat-label">@Localizer["Positions"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card stat-info">
            <div class="card-body text-center">
                <div class="stat-number">@Model.TotalPublishedCvs</div>
                <div class="stat-label">@Localizer["Published CVs"]</div>
            </div>
        </div>
    </div>
</div>

@if (Model.LatestPositions.Any())
{
    var canManagePositions = User.IsInRole("Recruiter") || User.IsInRole("Administrator");
    <div class="section-card mb-4">
        <div class="section-title">@Localizer["Latest Positions"]</div>
        <ul class="list-group list-group-flush">
            @foreach (var pos in Model.LatestPositions)
            {
                if (canManagePositions)
                {
                    <a asp-controller="Positions" asp-action="Details" asp-route-id="@pos.Id"
                       class="list-group-item list-group-item-action">@pos.Title</a>
                }
                else
                {
                    <span class="list-group-item">@pos.Title</span>
                }
            }
        </ul>
    </div>
}

@if (Model.TopPositions.Any())
{
    var canManagePositions = User.IsInRole("Recruiter") || User.IsInRole("Administrator");
    <div class="section-card mb-4">
        <div class="section-title">@Localizer["Top Positions"]</div>
        <ul class="list-group list-group-flush">
            @foreach (var pos in Model.TopPositions)
            {
                if (canManagePositions)
                {
                    <a asp-controller="Positions" asp-action="Details" asp-route-id="@pos.Id"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        @pos.Title
                        <span class="badge bg-primary rounded-pill">@pos.CvCount CVs</span>
                    </a>
                }
                else
                {
                    <span class="list-group-item d-flex justify-content-between align-items-center">
                        @pos.Title
                        <span class="badge bg-primary rounded-pill">@pos.CvCount CVs</span>
                    </span>
                }
            }
        </ul>
    </div>
}

@if (Model.TagCloud.Any())
{
    <div class="section-card mb-4">
        <div class="section-title">@Localizer["Popular Tags"]</div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var tag in Model.TagCloud)
            {
                var fontSize = Math.Min(tag.UsageCount * 2, 20);
                <a asp-controller="Search" asp-action="Index" asp-route-tag="@tag.Name"
                   class="badge bg-secondary text-decoration-none"
                   style="font-size: calc(12px + @(fontSize)px);">@tag.Name</a>
            }
        </div>
    </div>
}
