@model CvManagement.Web.Models.Attributes.AttributeIndexViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Attributes"];
}

<h2>@Localizer["Attributes"]</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="section-card">
    <form method="get" asp-action="Index" id="filterForm" class="mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <input type="text" name="prefix" value="@Model.Prefix" class="form-control" placeholder="@Localizer["Search by name..."]" />
            </div>
            <div class="col-md-4">
                <div class="form-check mt-2">
                    <input type="checkbox" name="recentOnly" value="true" class="form-check-input"
                           checked="@(Model.RecentOnly ? "checked" : null)" onchange="this.form.submit()" id="recentOnly" />
                    <label class="form-check-label" for="recentOnly">@Localizer["Recent only"]</label>
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-secondary btn-sm">@Localizer["Filter"]</button>
            </div>
        </div>
    </form>

    <div class="toolbar mb-3">
        <a asp-action="Create" class="btn btn-primary btn-sm">@Localizer["+ Create"]</a>
        <a asp-action="Edit" class="btn btn-warning btn-sm d-none" id="btnEdit">@Localizer["Edit"]</a>
        <form method="post" asp-action="Delete" class="d-inline" id="deleteForm">
            <button type="submit" class="btn btn-danger btn-sm d-none" id="btnDelete">@Localizer["Delete"]</button>
        </form>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th style="width:40px"></th>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Category"]</th>
                <th>@Localizer["Data Type"]</th>
                <th>@Localizer["Description"]</th>
                <th style="width:100px">@Localizer["Options"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="form-check-input row-checkbox" data-id="@item.Id" />
                    </td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.DataTypeDisplay</td>
                    <td>@item.Description</td>
                    <td>@item.OptionsCount</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        (function () {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            const btnEdit = document.getElementById('btnEdit');
            const btnDelete = document.getElementById('btnDelete');
            const deleteForm = document.getElementById('deleteForm');

            function updateToolbar() {
                const checked = document.querySelectorAll('.row-checkbox:checked');
                const count = checked.length;

                btnEdit.classList.toggle('d-none', count !== 1);
                btnDelete.classList.toggle('d-none', count < 1);

                if (count === 1) {
                    btnEdit.href = '@Url.Action("Edit")/' + checked[0].dataset.id;
                }
            }

            checkboxes.forEach(cb => cb.addEventListener('change', updateToolbar));

            deleteForm.addEventListener('submit', function (e) {
                if (!confirm('Удалить выбранные атрибуты?')) {
                    e.preventDefault();
                    return;
                }
                const existing = deleteForm.querySelectorAll('input[name="ids"]');
                existing.forEach(el => el.remove());

                document.querySelectorAll('.row-checkbox:checked').forEach(cb => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'ids';
                    input.value = cb.dataset.id;
                    deleteForm.appendChild(input);
                });
            });
        })();
    </script>
}
